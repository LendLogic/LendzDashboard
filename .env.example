# Monday API (server-side only — never VITE_*)
MONDAY_API_TOKEN=
# Board ids live in shared/registry.ts — one dedicated Monday board per module,
# read whole. An entry with no board id stays hidden until it gets one.
# ID_MONDAY_<KEY> overrides the registry at runtime and is normally left unset;
# use it only to repoint a board without a deploy (e.g. ID_MONDAY_PE=18420951236).
# Azure Blob Storage account name (required). Access is via Managed Identity
# (DefaultAzureCredential) — no account keys or SAS tokens in env.
AZURE_STORAGE_ACCOUNT=
# Optional — blob container for readiness payloads. Defaults to `readiness`.
AZURE_BLOB_CONTAINER=readiness
# Optional — HTTP port for the Express server. Defaults to 3000.
PORT=3000
